# Telegram Bot Configuration
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# (Opsional) Local Telegram Bot API Server
# Kosongkan jika memakai cloud standar (limit 50 MB).
# Jika menggunakan local bot API server di VPS, aktifkan baris berikut untuk limit hingga 2000 MB (2 GB):
# LOCAL_BOT_API_URL="http://127.0.0.1:8081/bot"
# MAX_FILE_SIZE_MB=2000

# Folder direktori penyimpanan sementara di VPS
DOWNLOAD_DIR="/tmp/vidara_downloads"

# Network & Identity Settings
# Digunakan untuk bypass proteksi server dan menyamar sebagai browser Android
VIDARA_USER_AGENT="Mozilla/5.0 (Linux; Android 14; 2406ERN9CI Build/UKQ1.240116.001; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/149.0.7827.91 Mobile Safari/537.36"

# API Endpoints
# Target path untuk mengekstrak URL streaming video
VIDARA_API_ENDPOINT="/api/stream"

# Device Identifiers
# Simulasi platform device (android, ios, web)
VIDARA_DEVICE_TYPE="android"
