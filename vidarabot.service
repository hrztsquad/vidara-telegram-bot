[Unit]
Description=Telegram Vidara Downloader Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/vidara-telegram-bot
ExecStart=/root/vidara-telegram-bot/venv/bin/python /root/vidara-telegram-bot/bot.py
Restart=always
RestartSec=5
EnvironmentFile=/root/vidara-telegram-bot/.env

[Install]
WantedBy=multi-user.target
